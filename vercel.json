{
  "trailingSlash": false,
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/panel",
      "destination": "/panel/index.html"
    },
    {
      "source": "/panel/(.*)",
      "destination": "/panel/index.html",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "text/html.*"
        }
      ]
    },
    {
      "source": "/offline",
      "destination": "/offline.html"
    },
    {
      "source": "/404",
      "destination": "/404.html"
    },
    {
      "source": "/como-funciona",
      "destination": "/public/como-funciona.html"
    },
    {
      "source": "/exames",
      "destination": "/public/exames.html"
    },
    {
      "source": "/cursos",
      "destination": "/public/cursos.html"
    },
    {
      "source": "/sobre",
      "destination": "/public/sobre.html"
    },
    {
      "source": "/termos",
      "destination": "/public/termos.html"
    },
    {
      "source": "/contacto",
      "destination": "/public/contacto.html"
    },
    {
      "source": "/((?!panel).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/panel/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/offline.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/404.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/panel/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/public/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
